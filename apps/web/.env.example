# ===================
# ADAMASTOR Web App Environment Variables
# ===================
# Copy this file to .env.local for local development

# ===================
# SUPABASE
# ===================
# For frontend (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# ===================
# SENTRY (Error Monitoring)
# ===================
# Runtime DSN (client-side) - Required for error reporting
# Get from: Sentry Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Environment identifier for Sentry (production | staging | local)
VITE_ENVIRONMENT=local

# ===================
# SENTRY BUILD-TIME (Source Maps)
# ===================
# These are only needed for production builds to upload source maps.
# Not required for local development.
#
# Auth token for source map uploads
# Get from: Sentry Account Settings -> Auth Tokens -> Create New Token
# Required scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=your-sentry-auth-token
#
# Your Sentry organization slug (visible in Sentry URL)
SENTRY_ORG=your-org-slug
#
# Your project slug (visible in Sentry URL)
SENTRY_PROJECT=your-project-slug
