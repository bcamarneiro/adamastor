{
  "name": "web",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "bun vite",
    "dev:debug": "bun vite --debug --logLevel info",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke",
    "e2e:data-contracts": "playwright test data-contracts/ --workers=4",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "DEBUG=pw:webserver,pw:browser* playwright test --headed --timeout=0",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.2.1",
    "@sentry/react": "^10.32.1",
    "@supabase/supabase-js": "^2.89.0",
    "@tailwindcss/vite": "^4.0.7",
    "@tanstack/react-query": "^5.66.11",
    "@tanstack/react-virtual": "^3.13.6",
    "@types/lodash": "^4.17.16",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "@xyflow/react": "^12.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.5.0",
    "html-to-image": "^1.11.13",
    "lodash": "^4.17.21",
    "lucide-react": "^0.571.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.0.1",
    "react-minimal-pie-chart": "^9.1.0",
    "react-router-dom": "^7.1.5",
    "remark-gfm": "^4.0.1",
    "shared": "workspace:*",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.7",
    "use-sync-external-store": "^1.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.11",
    "@playwright/test": "^1.57.0",
    "@sentry/vite-plugin": "^4.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.1.3",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "shadcn": "^3.8.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
