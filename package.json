{
  "name": "adamastor",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:debug": "bun run --cwd apps/web vite --debug --logLevel info",
    "build": "turbo run build",
    "sync": "turbo run sync",
    "test": "turbo run test",
    "test:web": "cd apps/web && vitest run src",
    "test:watcher": "cd apps/watcher && bun test",
    "e2e": "turbo run e2e",
    "e2e:ui": "bun --filter web e2e:ui",
    "e2e:debug": "bun --filter web e2e:debug",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "turbo": "^2.7.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8"
  }
}
