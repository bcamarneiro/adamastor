{
  "name": "adamastor",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web vite",
    "dev:debug": "bun run --cwd apps/web vite --debug --logLevel info",
    "build": "bun --filter web build",
    "sync": "bun --filter watcher start",
    "test": "bun test",
    "e2e": "bun --filter web e2e",
    "e2e:ui": "bun --filter web e2e:ui",
    "e2e:debug": "bun --filter web e2e:debug",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "cd apps/watcher && bun tsc --noEmit && cd ../web && bun tsc --noEmit",
    "prepare": "husky",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8"
  }
}
